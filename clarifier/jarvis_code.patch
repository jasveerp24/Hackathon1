+"""
+Clarifier tests INSIDE JARVIS. Run with no API keys (mock mode):  python test_clarifier_jarvis.py
+Each test plays a short conversation through the real Orchestrator and checks what JARVIS says.
+(test_clarifier.py tests clarifier.py on its own, with no other project files.)
+"""
+import os
+import tempfile
+
+for key in ("ANTHROPIC_API_KEY", "GEMINI_API_KEY", "TYPESAFE_API_KEY"):
+    os.environ.pop(key, None)   # force mock mode so the tests never call a real model
+
+from types import SimpleNamespace as N
+
+import agents  # noqa: F401  registers the agents
+import orchestrator
+import providers
+from agents import ActionAgent, AgentSpec, build_agent
+import clarifier
+from clarifier import has_place, has_time, is_danger, missing_details, needs_clarifier
+from config import CONFIG
+from orchestrator import AGENTS, Orchestrator, SafetyGate
+
+CONFIG["audit_log"] = os.path.join(tempfile.mkdtemp(), "audit.jsonl")
+
+# A stand-in for the check-in agent Rushil's WhatsApp tools will power.
+build_agent(AgentSpec(
+    name="checkin",
+    description="Start a safety check-in trip: where the user is going and when they will be back.",
+    instructions="Start a trip.",
+), ActionAgent)
+
+ASK_BOTH = "Where are you going, and when will you be back?"
+
+
+def talk(*turns):
+    jarvis = Orchestrator()
+    replies = [jarvis.handle(t) for t in turns]
+    return jarvis, replies
+
+
+def test_asks_for_both_missing_details_then_routes():
+    jarvis, r = talk("I'm going out", "Le Pouce, back by two")
+    assert r[0] == ASK_BOTH, r[0]
+    assert r[1].startswith("[mock:checkin]"), r[1]
+    assert "I'm going out. Le Pouce, back by two" in r[1]   # the answer was merged into the request
+    assert jarvis.clarifying is None
+
+
+def test_asks_only_for_what_is_still_missing():
+    jarvis, r = talk("I'm going out", "In ten minutes", "Trou aux Cerfs")
+    assert r[0] == ASK_BOTH
+    assert r[1] == "Where are you going?", r[1]
+    assert r[2].startswith("[mock:checkin]"), r[2]
+
+
+def test_one_detail_given_asks_for_the_other():
+    _, r = talk("I'm heading to Le Pouce")
+    assert r[0] == "When should I expect you back?", r[0]
+
+
+def test_keeps_asking_until_complete():
+    jarvis, r = talk("I'm going out", "I don't know", "dunno", "not sure", "um", "Le Pouce, back at 5pm")
+    assert r[0] == ASK_BOTH
+    assert r[1] == "Sorry, I didn't catch that. " + ASK_BOTH     # no limit: it asks again...
+    assert r[2].endswith("If you need urgent help, just say help.")   # ...with a way out every 3rd question
+    assert r[3] == r[4] == "Sorry, I didn't catch that. " + ASK_BOTH
+    assert r[5].startswith("[mock:checkin]"), r[5]               # complete at last: handed to the agent
+    assert jarvis.pending is None and jarvis.clarifying is None
+
+
+def test_saying_help_in_the_loop_offers_sos():
+    jarvis, r = talk("I'm going out", "dunno", "help")
+    assert "may be in danger" in r[2], r[2]
+    assert jarvis.pending.agent == CONFIG["sos_agent"]
+
+
+def test_danger_skips_questions():
+    jarvis, r = talk("someone is following me")
+    assert "may be in danger" in r[0], r[0]
+    assert jarvis.pending.agent == CONFIG["sos_agent"]
+    assert jarvis.handle("yes").startswith(f"[mock:{CONFIG['sos_agent']}]")
+
+
+def test_danger_mid_clarification():
+    jarvis, r = talk("I'm going out", "help!")
+    assert "may be in danger" in r[1], r[1]
+    assert jarvis.pending is not None
+
+
+def test_danger_without_sos_agent_says_call_999():
+    saved = AGENTS.pop(CONFIG["sos_agent"])
+    try:
+        jarvis, r = talk("I'm scared, he is hitting me")
+        assert "call 999" in r[0] and jarvis.pending is None, r[0]
+    finally:
+        AGENTS[CONFIG["sos_agent"]] = saved
+
+
+def test_cancel_mid_clarification():
+    jarvis, r = talk("I'm going out", "never mind")
+    assert r[1] == "Okay, cancelled." and jarvis.clarifying is None
+
+
+def test_complete_requests_are_not_clarified():
+    for text in ["Leaving Ebene, home by eleven", "I'm going to Curepipe, back at 5pm",
+                 "When is the next bus from Curepipe?", "Tell my family I'm safe",
+                 "My bank says my account is blocked, is it real?"]:
+        rule, missing = missing_details(text)
+        assert not missing, (text, missing)
+
+
+def test_other_rules():
+    assert talk("Tell my family")[1][0] == "What would you like me to tell them?"
+    assert talk("Is this a scam?")[1][0].startswith("Please read me the message")
+    assert talk("I'll be late")[1][0] == "By how long?"
+
+
+def test_detectors():
+    assert has_time("back by two") and has_time("in half an hour") and has_time("at 14:30")
+    assert not has_time("I'm going out")
+    assert has_place("to Le Pouce") and has_place("going home") and not has_place("going out for a walk")
+    assert is_danger("Help me!") and is_danger("I can't breathe") and is_danger("au secours")
+    assert not is_danger("Can you help me find a clinic?") and not is_danger("What's the emergency number?")
+
+
+def test_new_question_is_not_merged_into_old_one():
+    jarvis, r = talk("I'm going out", "What should I do in a cyclone class 3?")
+    assert r[0] == ASK_BOTH
+    assert "task='What should I do in a cyclone class 3?'" in r[1], r[1]   # routed on its own
+    assert "going out" not in r[1]                                        # not glued to the old request
+    assert jarvis.clarifying is None
+
+
+def test_english_only_by_default():
+    assert clarifier.SETTINGS["languages"] == ["en"]
+    assert talk("Je sors")[1][0] == ASK_BOTH            # French words understood, reply in English
+    assert "may be in danger" in talk("au secours")[1][0]   # French danger still caught
+
+
+def test_french():
+    clarifier.configure(languages=["en", "fr"])
+    try:
+        _test_french()
+    finally:
+        clarifier.configure(languages=["en"])
+
+
+def _test_french():
+    jarvis, r = talk("Je sors", "dans dix minutes")
+    assert r[0] == "Où allez-vous, et quand serez-vous de retour ?", r[0]
+    assert r[1] == "Où allez-vous ?", r[1]
+    # Answering "au Pouce" completes it (which agent gets it is the router's job, not tested here).
+    jarvis.clarifying.answers.append("au Pouce")
+    assert not needs_clarifier("Je sors. dans dix minutes. au Pouce", jarvis.clarifying)
+    assert not missing_details("Je sors, au marché, je rentre vers deux heures")[1]
+    assert talk("Je pars à Curepipe")[1][0] == "À quelle heure dois-je vous attendre ?"
+    assert talk("Dis à ma famille")[1][0] == "Que voulez-vous que je leur dise ?"
+    assert talk("Est-ce une arnaque ?")[1][0].startswith("Lisez-moi le message")
+    assert talk("Je serai en retard")[1][0] == "De combien de temps ?"
+    jarvis, r = talk("Je sors", "laisse tomber")
+    assert r[1] == "D'accord, c'est annulé.", r[1]
+    jarvis, r = talk("Quelqu'un me suit")
+    assert r[0].startswith("On dirait que vous êtes en danger"), r[0]
+    assert jarvis.pending is not None
+    for text in ["au secours", "Aidez-moi", "j'ai peur", "il me frappe", "je ne peux pas respirer",
+                 "appelez la police", "à l'aide"]:
+        assert is_danger(text), text
+    for text in ["Pouvez-vous m'aider à trouver une clinique ?", "Quel est le numéro d'urgence ?"]:
+        assert not is_danger(text), text
+
+
+def test_english_and_french_only():
+    assert not is_danger("mo bizin led")   # Kreol is not supported
+
+
+class FakeClaude:
+    # Stands in for Claude: says a detail is missing until the user has given an area.
+    def __init__(self):
+        self.messages = self
+
+    def create(self, **kwargs):
+        prompt = str(kwargs["messages"][0]["content"])
+        if str(kwargs.get("system", "")).startswith("You are a router"):
+            task = prompt.replace('"', "'")
+            return N(stop_reason="end_turn", content=[N(type="text", text=f'[{{"agent": "health", "task": "{task}"}}]')])
+        if "Rose-Hill" in prompt:
+            return N(stop_reason="end_turn", content=[N(type="text", text="Clinic Central in Rose-Hill is open.")])
+        return N(stop_reason="end_turn", content=[N(type="text", text="NEED_DETAILS: find_clinic.area")])
+
+
+def test_any_tool_missing_detail_is_asked_for():
+    saved = providers.claude.client
+    agents.claude.client = FakeClaude()
+    try:
+        jarvis, r = talk("Find me a clinic", "Rose-Hill")
+        assert r[0] == "Which area are you in?", r[0]          # the question comes from the tool's `asks`
+        assert "Clinic Central" in r[1], r[1]                  # answer merged, the agent completes it
+        assert jarvis.clarifying is None
+    finally:
+        agents.claude.client = saved
+
+
+def test_tool_without_asks_gets_a_default_question():
+    from clarifier import ask_for_tool_details
+    assert ask_for_tool_details([{"tool": "t", "param": "pickup_point", "question": None}]) == \
+        "Could you tell me the pickup point?"
+    assert ask_for_tool_details([{"tool": "t", "param": "date", "question": None},
+                                 {"tool": "t", "param": "city", "question": None}]) == \
+        "Could you tell me the date and city?"
+
+
+class FakeJev:
+    live = True
+
+    def __init__(self, danger):
+        self.danger = danger
+
+    def ask(self, state, questions):
+        answers = {"is_clear": {"noul": 0.9}, "route": {"choice": "info", "confidence": 0.9, "probabilities": {}}}
+        if "is_danger" in questions:
+            answers["is_danger"] = {"noul": self.danger}
+        return answers
+
+
+def test_jev_catches_danger_the_keywords_miss():
+    saved = orchestrator.jev
+    try:
+        orchestrator.jev = FakeJev(danger=0.92)
+        text = "there's a man behind me and I don't feel ok"
+        assert not is_danger(text)                             # not on the keyword list...
+        jarvis, r = talk(text)
+        assert "may be in danger" in r[0], r[0]                # ...but Jev catches it
+        orchestrator.jev = FakeJev(danger=0.10)
+        assert "may be in danger" not in talk("What should I do in a cyclone class 3?")[1][0]
+    finally:
+        orchestrator.jev = saved
+
+
+def test_sessions_do_not_share_questions():
+    a, b = Orchestrator(), Orchestrator()
+    a.handle("I'm going out")
+    assert a.clarifying is not None and b.clarifying is None
+
+
+def test_safety_gate_never_blocks_the_clarifier():
+    original = SafetyGate.decide
+    SafetyGate.decide = lambda self, step: "refuse"
+    try:
+        _, r = talk("someone is following me")
+        assert "may be in danger" in r[0], r[0]
+    finally:
+        SafetyGate.decide = original
+
+
+if __name__ == "__main__":
+    tests = [(n, f) for n, f in globals().items() if n.startswith("test_")]
+    failed = 0
+    for name, fn in tests:
+        try:
+            fn()
+            print("PASS", name)
+        except AssertionError as error:
+            failed += 1
+            print("FAIL", name, "->", error)
+    print(f"\n{len(tests) - failed}/{len(tests)} passed")
+    raise SystemExit(1 if failed else 0)
