# Copy to .env and fill in. NEVER commit .env.

# --- Meta WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup) ---
WA_ACCESS_TOKEN=PASTE_SYSTEM_USER_TOKEN_HERE
WA_PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID_HERE
WA_API_VERSION=v21.0
# Any random string you invent; paste the same in Meta > WhatsApp > Configuration > Webhook
WA_WEBHOOK_VERIFY_TOKEN=change-me-to-a-random-string
# Meta app > Settings > Basic > App secret. Required for "reply SAFE" check-ins (proves the call is from Meta).
WA_APP_SECRET=
# false until your templates are approved (plain text needs the family to message the number first)
WA_USE_TEMPLATES=false
# Languages you submitted AND got approved in WhatsApp Manager (e.g. en  or  en,fr).
# In template mode, contacts in any other language get the English template.
WA_TEMPLATE_LANGS=en
# true = log messages instead of sending. Also automatic when the token is empty.
WA_DRY_RUN=false

# --- Storage (leave empty to use in-memory store) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hackathon

# --- Security ---
# Invent a long random string (e.g. run: python -c "import secrets;print(secrets.token_urlsafe(24))").
# Put the SAME value in frontend/.env as VITE_ALERTS_API_KEY. Empty = API open (local dev only).
ALERTS_API_KEY=
ALERTS_RATE_LIMIT_PER_USER_PER_MINUTE=10
ALERTS_RATE_LIMIT_GLOBAL_PER_MINUTE=60
# true only while rehearsing/demoing the "Run missed check-in check now" button
ALERTS_ENABLE_DEV_ROUTES=true

# --- Governance ---
# Closed trips and alert logs older than this are deleted automatically (hourly check)
ALERTS_RETENTION_DAYS=30

# --- Behaviour ---
ALERTS_TIMEZONE=Indian/Mauritius
ALERTS_DEFAULT_COUNTRY_CODE=230
ALERTS_GRACE_MINUTES=30
ALERTS_SCHEDULER_INTERVAL_SECONDS=30
ALERTS_EMERGENCY_NUMBER=999
# Name used in the custom alert ("Sent by the ... app"). Set it to the day's app name.
ALERTS_APP_NAME=Safe Check-in
FRONTEND_ORIGIN=http://localhost:5173
